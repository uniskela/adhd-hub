# Shared bearer token for REST + MCP + /ui login (required in production).
# Open /ui → enter this same token in the login form (stored in the browser).
ADHD_HUB_AUTH_TOKEN=change-me-to-a-long-random-string

# Optional OpenClaw bridge (leave empty to disable)
ADHD_HUB_OPENCLAW_WEBHOOK_URL=http://openclaw:18789/hooks/wake
ADHD_HUB_OPENCLAW_TOKEN=

# Bind (Docker / Tailscale: 0.0.0.0; local-only: 127.0.0.1)
ADHD_HUB_HOST=0.0.0.0
ADHD_HUB_PORT=8787

# Public base URL used in memory-repo README → /ui link and the allowed browser CORS origin.
# ADHD_HUB_PUBLIC_URL=http://100.x.x.x:8787
# ADHD_HUB_TIMEZONE=Australia/Sydney
# ADHD_HUB_REMIND_COOLDOWN_DAYS=3
# ADHD_HUB_DIGEST_MAX_NUDGE=2

# Data directory (wiki + SQLite). Back up / migrate with /ui → Settings → Export,
# or GET /api/admin/export (Bearer token). Restore via Import or POST /api/admin/import.
ADHD_HUB_DATA_DIR=/data

# Optional GitHub / Gitea forge (also configurable in /ui)
# When you connect a forge that already has projects/*/PROGRESS.md, /ui offers Import.
# ADHD_HUB_FORGE_PROVIDER=github
# ADHD_HUB_FORGE_BASE_URL=https://api.github.com
# ADHD_HUB_FORGE_TOKEN=
# ADHD_HUB_FORGE_OWNER=
# ADHD_HUB_FORGE_REPO=
# ADHD_HUB_FORGE_WIKI_ENABLED=true
# ADHD_HUB_FORGE_WIKI_PATH=          # blank = repo root (recommended for primary memory)
# ADHD_HUB_FORGE_PRIMARY_MEMORY_REPO=true
# ADHD_HUB_FORGE_BOARD_ENABLED=true
# ADHD_HUB_FORGE_PROJECT_NUMBER=1
# For Gitea:
# ADHD_HUB_FORGE_PROVIDER=gitea
# ADHD_HUB_FORGE_BASE_URL=https://gitea.example.com/api/v1
# ADHD_HUB_FORGE_PROJECT_ID=1
